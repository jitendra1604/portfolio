# Copy to .env.local and fill in. All values are optional in dev.

# Public site URL — used for metadata, OpenGraph, robots.txt and sitemap.xml.
# Set this to your real domain in production (e.g. https://jeet.dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# --- Contact form email (SMTP via Nodemailer) -------------------------------
# Without these, the contact form validates and logs only (no email sent).
# Gmail example: create an App Password (Google Account → Security →
# 2-Step Verification → App passwords) and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
# Where contact messages are delivered (defaults to SMTP_USER if unset).
CONTACT_TO=jeet@zyptr.com

# --- Live chat (Ably realtime + owner notifications) ------------------------
# Without ABLY_API_KEY the "Chat with me" widget is disabled (503 on room
# creation) — free tier at ably.com, no card required.
ABLY_API_KEY=

# Telegram notification when a visitor starts a chat. Message @BotFather to
# create a bot and get a token; message the bot once, then use @userinfobot
# (or the getUpdates endpoint) to find your numeric chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp notification via CallMeBot's free personal-use API (unofficial —
# see callmebot.com for the one-time WhatsApp opt-in message to get an API key).
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Long random secret gating the admin (owner) side of a chat room — this is
# the only thing that proves "this is Jeet" for any room. Generate with
# `openssl rand -hex 32`. Do NOT use a memorable password.
CHAT_ADMIN_SECRET=

# --- Blog: Notion (write posts without touching code) -----------------------
# Without these, /blog only shows posts from content/blog/*.mdx.
# 1. Create a free integration at notion.so/my-integrations, copy its token.
# 2. Create a Notion database with properties: Title (title), Slug (text),
#    Description (text), Tag (select or text), Date (date), Published
#    (checkbox). Share the database with your integration.
# 3. Copy the database ID from its URL (the 32-char id before the "?").
# New/edited posts (with Published checked) appear on the live site within
# ~30s, no redeploy needed.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Blog: RSS syndication (Medium / Dev.to / Hashnode) ----------------------
# Pulls in posts you publish elsewhere and lists them alongside your own,
# linking out to the original. Free — just their public RSS feeds.
# Format: "Platform=feedUrl,Platform=feedUrl". Example:
# BLOG_RSS_FEEDS=Medium=https://medium.com/feed/@yourhandle,Dev.to=https://dev.to/feed/yourhandle,Hashnode=https://yourblog.hashnode.dev/rss.xml
BLOG_RSS_FEEDS=
